# Render Postgres connection string
DATABASE_URL=postgres://user:pass@host/crawlguard

# Random 32-char string: openssl rand -hex 16
SESSION_SECRET=changeme_32_char_random_string

# From resend.com dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your deployed URL (no trailing slash)
BASE_URL=https://crawlguard.onrender.com

# Optional: override sender address (requires verified domain in Resend)
# Default uses Resend's shared onboarding@resend.dev which works without DNS setup
FROM_EMAIL=CrawlGuard <noreply@yourdomain.com>

# Server port (Render sets this automatically)
PORT=3000
